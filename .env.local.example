# ─── Tenant ───────────────────────────────────────────────────────────────────
# Qual loja ativar: 'paizao' ou 'magnnata'
NEXT_PUBLIC_TENANT=paizao

# ─── Firebase Client (público — vai para o bundle do browser) ───────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=    # necessário para Auth funcionar
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (secreto — apenas no servidor) ───────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=                  # service account email
FIREBASE_PRIVATE_KEY=                   # -----BEGIN RSA PRIVATE KEY-----\n...

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# Paizão: 5561985818667
# Magnnata: número real da loja (só dígitos, com DDI 55)
NEXT_PUBLIC_WA_NUMBER=

# ─── Instagram Graph API (opcional) ──────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ─── Admin ────────────────────────────────────────────────────────────────────
# E-mails autorizados a acessar /admin, separados por vírgula
NEXT_PUBLIC_ADMIN_EMAILS=seu@email.com

