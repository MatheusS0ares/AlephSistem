# ── Supabase ──────────────────────────────────────────────────
# Modo compartilhado (prospects/trial): use as credenciais do projeto central
# Modo dedicado (cliente pagante): use as credenciais do projeto próprio do cliente
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Identidade do cliente ──────────────────────────────────────
# Slug da loja neste deploy (deve existir na tabela 'stores' do Supabase)
# Se não definido, exibe o StoreSelector (modo demo/multi-loja)
VITE_CLIENT_SLUG=nome-da-loja

# Nome exibido no painel admin e título da aba
VITE_CLIENT_NAME=Nome da Loja

# Modo de operação: 'shared' (Supabase compartilhado) ou 'dedicated'
VITE_SUPABASE_MODE=shared

# ── Admin ──────────────────────────────────────────────────────
# Senha de acesso ao painel administrativo (específica por deploy)
VITE_ADMIN_PASSWORD=senha_segura_aqui
